# Copy to .env; environment variables take precedence over TOML.
MDA_ANALYSIS__MODE=fast
MDA_ANALYSIS__MAX_HYPOTHESES=3
MDA_ANALYSIS__MAX_TOOL_CALLS=8
MDA_ANALYSIS__MAX_CRITIC_CYCLES=1
MDA_ANALYSIS__MINIMUM_SAMPLE_SIZE=20
MDA_PERFORMANCE__TIMEOUT_SECONDS=15
MDA_PERFORMANCE__PARALLEL_TOOLS=true
MDA_LLM__PROVIDER=disabled
# MDA_LLM__MODEL=configure-when-an-adapter-exists
MDA_LLM__TEMPERATURE=0.0
MDA_LLM__MAX_RETRIES=2
MDA_EVALUATION__REPETITIONS=3
MDA_PERSISTENCE__DATABASE_URL=sqlite:///:memory:

# Optional intake policy overrides; complete defaults live in defaults.toml.
# MDA_DATA_INTAKE__CATEGORICAL_MAX_UNIQUE=20
# MDA_DATA_INTAKE__CATEGORICAL_UNIQUE_RATIO=0.1
# MDA_DATA_INTAKE__CATEGORICAL_MAX_LENGTH=64
# MDA_DATA_INTAKE__IDENTIFIER_UNIQUE_RATIO=0.95
# MDA_DATA_INTAKE__IDENTIFIER_MAX_LENGTH=128
# MDA_DATA_INTAKE__IDENTIFIER_NAME_TOKENS=["id","identifier","uuid","identificador"]
# MDA_DATA_INTAKE__TEXT_NAME_TOKENS=["description","comment","notes"]
# MDA_DATA_INTAKE__TEMPORAL_PARSE_RATIO=1.0
# MDA_DATA_INTAKE__TEMPORAL_FORMATS=["%Y-%m-%d","%d/%m/%Y"]

# Web upload limits (bytes). Temporary files use the OS temp directory by default.
# 0 = unlimited dataset size; a positive value sets a limit in bytes.
MDA_UPLOADS__MAX_DATASET_BYTES=0
# MDA_UPLOADS__MAX_DICTIONARY_BYTES=1048576
# MDA_UPLOADS__CHUNK_SIZE_BYTES=65536
# MDA_UPLOADS__TEMPORARY_DIRECTORY=C:\path\to\an\existing\directory
